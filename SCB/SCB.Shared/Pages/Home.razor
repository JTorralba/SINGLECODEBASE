@page "/"

@using SCB.Shared.Services

@inject IJSRuntime JS

@inject IFormFactor FormFactor

<PageTitle>Home</PageTitle>

<div class="center">
	@if (GreenLight)
	{
		<div class="center-text">@BlazorType</div>
		<div class="center-text">@DeviceType</div>
		<div class="center-text">@PlatformType</div>
		<div class="center-text">@IP_WAN</div>
		<div class="center-text">@IP_LAN</div>
		<div class="center-text">@TimeStamp</div>
	}
</div>

@code {
	private bool GreenLight = false;

	private string BlazorType => FormFactor.GetBlazorType();
	private string DeviceType => FormFactor.GetDeviceType();
	private string PlatformType => FormFactor.GetPlatformType();

	private string IP_WAN = string.Empty;
	private string IP_LAN = string.Empty;

	private string TimeStamp = string.Empty;

	protected override async Task OnAfterRenderAsync(bool FirstRender)
	{
		if (!FirstRender)
			return;

		if (BlazorType != "Blazor Hybrid")
		{
			IP_WAN = FormFactor.GetIP_WAN();
			IP_LAN = FormFactor.GetIP_LAN();

			try
			{
				var JSON = await JS.InvokeAsync<JsonElement>("eval", "fetch('https://api.ipify.org').then((body)=>body.text())");

				var Result = JSON.GetString();

				if (string.IsNullOrEmpty(Result))
				{
					Result = "WAN?";
				}

				IP_WAN = Result;
			}
			catch (Exception X)
			{
				IP_WAN = "WAN?";
			}

			try
			{
				var Result  = await JS.InvokeAsync<string>("GetLocalIPAddress");

				if (string.IsNullOrEmpty(Result))
				{
					Result = "WebRTC?";
				}

				IP_LAN = Result;
			}
			catch (Exception X)
			{
				IP_LAN = "WebRTC?";
			}
		}
		else
		{
			IP_WAN = await FormFactor.GetIP_WAN_MAUI();

			IP_LAN = FormFactor.GetIP_LAN_MAUI();
		}

		try
		{
			var Result = await JS.InvokeAsync<string>("GetTimeStamp");

			if (string.IsNullOrEmpty(Result))
			{
				Result = "TimeStamp?";
			}

			TimeStamp = Result;
		}
		catch (Exception X)
		{
			TimeStamp = "TimeStamp?";
		}

		GreenLight = true;

		StateHasChanged();

	}
}
